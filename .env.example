# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: comma-separated model list, tried in order
# GEMINI_MODEL=

# Supabase (free tier). Without these, rooms are stored in .data/ (local development only).
# Run supabase/schema.sql in the SQL editor first. Server-side only: never expose the service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated ids of published rooms to show on the home page
# FEATURED_ROOMS=
